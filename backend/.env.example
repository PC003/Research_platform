# Application
APP_NAME=UG Research Discovery Platform
APP_VERSION=0.2.0
API_PREFIX=/api/v1

# Data paths (used by the import script)
DATA_DIR=../data

# PostgreSQL connection (adjust credentials for your setup)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_platform

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# CORS
CORS_ORIGINS=["http://localhost:5173"]
