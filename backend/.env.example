# Application
APP_NAME=UG Research Discovery Platform
APP_VERSION=1.0.0
API_PREFIX=/api/v1

# PostgreSQL connection (adjust credentials for your setup)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research_platform

# Embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Search weights (hybrid search)
SEMANTIC_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
DEFAULT_SEARCH_LIMIT=20

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# CORS
CORS_ORIGINS=["http://localhost:5173"]
